+
+
+# --- Relatórios ---------------------------------------------------------------------------
+def pct(value):
+    return "—" if value is None or pd.isna(value) else f"{value:.1%}"
+
+
+def chosen_counts(regression):
+    names = regression.chosen.str.replace(r" ccp_alpha=.*", "", regex=True)
+    return names.str.split(" ").str[0].value_counts().to_dict()
